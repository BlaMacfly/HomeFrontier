+// UTF8ToSJIS encodes a UTF-8 string to Shift-JIS bytes. Runes that cannot be
+// represented in Shift-JIS are replaced by their ASCII fold (é → e) when one
+// exists, and silently dropped otherwise.
 func UTF8ToSJIS(x string) []byte {
 	e := japanese.ShiftJIS.NewEncoder()
 	xt, _, err := transform.String(e, x)
 	if err != nil {
 		// Filter out runes that can't be encoded to Shift-JIS instead of
 		// crashing the server (see PR #116).
-		var filtered []rune
+		var filtered strings.Builder
 		for _, r := range x {
 			if _, _, err := transform.String(japanese.ShiftJIS.NewEncoder(), string(r)); err == nil {
-				filtered = append(filtered, r)
+				filtered.WriteRune(r)
+			} else if folded, ok := latinFold[r]; ok {
+				filtered.WriteString(folded)
 			}
 		}
-		xt, _, _ = transform.String(japanese.ShiftJIS.NewEncoder(), string(filtered))
+		xt, _, _ = transform.String(japanese.ShiftJIS.NewEncoder(), filtered.String())
 	}
 	return []byte(xt)
 }
