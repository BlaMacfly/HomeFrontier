+// HomeFrontier: French text keeps its letters (folded) instead of losing them.
+func TestUTF8ToSJISFoldsLatinAccents(t *testing.T) {
+	tests := []struct{ in, want string }{
+		{"Réinitialisation le %d/%d", "Reinitialisation le %d/%d"},
+		{"La commande %s est désactivée", "La commande %s est desactivee"},
+		{"Cœur « garçon » à Noël", "Coeur \" garcon \" a Noel"},
+		{"ハンター é", "ハンター e"},
+	}
+	for _, tt := range tests {
+		got, err := SJISToUTF8(UTF8ToSJIS(tt.in))
+		if err != nil || got != tt.want {
+			t.Errorf("UTF8ToSJIS(%q) = %q (%v), want %q", tt.in, got, err, tt.want)
+		}
+	}
+	if got, _ := SJISToUTF8(bytes.TrimRight(PaddedString("Activé", 10, true), "\x00")); got != "Active" {
+		t.Errorf("PaddedString(\"Activé\") = %q, want \"Active\"", got)
+	}
+}
